<?xml version='1.0' encoding='utf-8'?>
<widget id="ai.gabai.app" version="61.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>GabAi</name>
  <description>Your AI Personal Assistant</description>
  <author email="support@gabai.ai" href="https://gabai.ai">GabAi Team</author>
  
  <content src="index.html" />
  
  <!-- Allow navigation -->
  <allow-navigation href="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  
  <!-- Android permissions -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-permission android:name="android.permission.READ_CONTACTS" />
  <uses-permission android:name="android.permission.WRITE_CONTACTS" />
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
  
  <!-- Android platform settings - SDK 35 FIX -->
  <platform name="android">
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <preference name="android-compileSdkVersion" value="35" />
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="GradlePluginKotlinVersion" value="1.9.24" />
  </platform>
  
  <!-- Cordova preferences -->
  <preference name="DisallowOverscroll" value="true" />
  <preference name="BackupWebStorage" value="cloud" />
  <preference name="Orientation" value="portrait" />
  
  <!-- Plugins -->
  <plugin name="cordova-plugin-device" />
  <plugin name="cordova-plugin-inappbrowser" />
  <plugin name="cordova-plugin-media" />
  <plugin name="cordova-plugin-camera" />
  <plugin name="cordova-plugin-file" />
  
  <!-- Enable mixed content -->
  <preference name="MixedContentMode" value="0" />
  
  <!-- Access origins -->
  <access origin="*" />
  
  <!-- Android API Level -->
  <preference name="android-minSdkVersion" value="23" />
  <preference name="android-targetSdkVersion" value="35" />
</widget>