<?xml version='1.0' encoding='utf-8'?>
<widget id="ai.gabai.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
    <name>GabAi</name>
    <description>Voice Assistant with Firebase Auth</description>
    <author email="support@gabai.ai">GabAi Team</author>
    <content src="index.html" />
    
    <!-- Platform versions -->
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-compileSdkVersion" value="34" />
    
    <!-- Firebase Authentication Plugin -->
    <plugin name="cordova-plugin-firebasex" source="npm" spec="^16.4.0" />
    
    <!-- Google Services Plugin for Firebase -->
    <plugin name="cordova-support-google-services" source="npm" spec="^1.4.1" />
    
    <!-- Network Information -->
    <plugin name="cordova-plugin-network-information" source="npm" spec="^3.0.0" />
    
    <!-- Device Info -->
    <plugin name="cordova-plugin-device" source="npm" spec="^2.1.0" />
    
    <!-- InAppBrowser for fallback authentication -->
    <plugin name="cordova-plugin-inappbrowser" source="npm" spec="^5.0.0" />
    
    <!-- Whitelist Plugin -->
    <plugin name="cordova-plugin-whitelist" source="npm" spec="^1.3.5" />
    
    <!-- Allow all navigation -->
    <allow-navigation href="*" />
    <allow-intent href="*" />
    
    <!-- Access rules -->
    <access origin="*" />
    <access origin="https://gabai.ai" />
    <access origin="https://accounts.google.com" />
    <access origin="https://firebase.googleapis.com" />
    
    <!-- Custom URL scheme for deep linking -->
    <plugin name="cordova-plugin-customurlscheme" source="npm" spec="^5.0.2">
        <variable name="URL_SCHEME" value="gabai" />
        <variable name="ANDROID_SCHEME" value="gabai" />
        <variable name="ANDROID_HOST" value="auth" />
        <variable name="ANDROID_PATHPREFIX" value="/callback" />
    </plugin>
    
    <!-- Android specific -->
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <preference name="GradlePluginKotlinCodeStyle" value="official" />
        <preference name="AndroidGradlePluginVersion" value="8.0.0" />
        
        <!-- Firebase config file -->
        <resource-file src="google-services.json" target="app/google-services.json" />
        
        <!-- Intent filters for custom URL scheme -->
        <config-file target="app/src/main/AndroidManifest.xml" parent="/manifest/application/activity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="gabai" android:host="auth" />
            </intent-filter>
        </config-file>
    </platform>
</widget>