<?xml version='1.0' encoding='utf-8'?>
<widget id="ai.gabai.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
    <name>GabAi</name>
    <description>Voice Assistant</description>
    <author email="support@gabai.ai">GabAi Team</author>
    <content src="index.html" />
    
    <!-- Platform versions - updated for compatibility -->
    <preference name="android-targetSdkVersion" value="35" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-compileSdkVersion" value="35" />
    
    <!-- Only essential, compatible plugins -->
    <plugin name="cordova-plugin-device" source="npm" spec="^2.1.0" />
    <plugin name="cordova-plugin-inappbrowser" source="npm" spec="^5.0.0" />
    
    <!-- Basic access rules -->
    <access origin="*" />
    <access origin="https://gabai.ai" />
    <access origin="https://accounts.google.com" />
    
    <!-- Android specific -->
    <platform name="android">
        <preference name="AndroidXEnabled" value="true" />
    </platform>
</widget>