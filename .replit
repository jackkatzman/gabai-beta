modules = [
  "nodejs-20",
  "web",
  "bash",
  "swift-5.8",
  "java-17",
  "postgresql-16",
  "python-3.11",
]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["docker_28", "imagemagick", "openjdk17", "unzip", "zip"]

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "./build-full.sh"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38085
externalPort = 3000

[[ports]]
localPort = 39923
externalPort = 3002

[[ports]]
localPort = 42649
externalPort = 3001

[[ports]]
localPort = 46793
externalPort = 3003

[agent]
integrations = [
  "javascript_database==1.0.0",
  "javascript_log_in_with_replit==1.0.0",
]

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]
