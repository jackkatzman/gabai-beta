modules = ["nodejs-20", "web", "bash", "swift-5.8", "java-17", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["docker_28", "imagemagick", "openjdk17", "unzip", "zip"]

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "npm run build "]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32995
externalPort = 3003

[[ports]]
localPort = 35087
externalPort = 5000

[[ports]]
localPort = 37541
externalPort = 4200

[[ports]]
localPort = 41423
externalPort = 3002

[[ports]]
localPort = 41827
externalPort = 5173

[[ports]]
localPort = 43063
externalPort = 6000

[[ports]]
localPort = 43603
externalPort = 3001

[[ports]]
localPort = 44549
externalPort = 6800

[[ports]]
localPort = 45733
externalPort = 3000

[[ports]]
localPort = 46805
externalPort = 8000

[agent]
integrations = ["javascript_database==1.0.0", "javascript_log_in_with_replit==1.0.0"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]
