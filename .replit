modules = ["nodejs-20", "web", "bash", "swift-5.8", "java-17", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"
packages = ["docker_28", "imagemagick", "openjdk17", "unzip", "zip"]

[deployment]
deploymentTarget = "cloudrun"
run = ["sh", "-c", "npm start"]
build = ["sh", "-c", "./build-full.sh"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 35043
externalPort = 3002

[[ports]]
localPort = 35705
externalPort = 3000

[[ports]]
localPort = 40495
externalPort = 3001

[agent]
integrations = [
  "javascript_database==1.0.0",
  "javascript_log_in_with_replit==1.0.0",
]

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[userenv]

[userenv.shared]
FREE_CHAT_PER_DAY = "50"
FREE_LIST_ITEMS_PER_DAY = "100"
FREE_REMINDERS_PER_DAY = "20"
DISABLE_CHAT_TEMPORARILY = "false"
